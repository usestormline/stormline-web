# WalletConnect/Reown project identifier. Configure this through Replit Secrets.
VITE_REOWN_PROJECT_ID=

# Optional Robinhood Chain mainnet RPC override. Defaults to Robinhood's public RPC.
VITE_RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com/

# Use 46630 for testnet development. Set 4663 only for an intentional mainnet build.
VITE_RH_CHAIN_ID=46630
